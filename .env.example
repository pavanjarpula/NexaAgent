# ============================================
# NexaAgent - Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Weaviate
WEAVIATE_URL=http://localhost:8080

# Ollama (run locally on host)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Embedding Model
EMBEDDING_MODEL=nomic-embed-text

# LLM
LLM_URL=http://host.docker.internal:11434/v1/chat/completions

# Employee Backend (internal)
EMPLOYEE_BACKEND_URL=http://employee-mcp-client:5000

# Food Backend (internal)
FOOD_API_URL=http://food-mcp-client:7123/

# Frontend Backend URL (what browser sees)
FRONTEND_BACKEND_URL=http://localhost:5000
FRONTEND_FOOD_URL=http://localhost:7123/
